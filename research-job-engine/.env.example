# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Use a long random password made of letters and digits only: it is embedded in a URL,
# so characters like @ : / # ? would break DATABASE_URL.

POSTGRES_USER=techpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techpulse

# Used when running Python directly on your machine. Docker Compose overrides it
# to point at the "db" container.
DATABASE_URL=postgresql+asyncpg://techpulse:change-me@localhost:5432/techpulse

# Production only (docker-compose.prod.yml): the domain Caddy serves, with automatic HTTPS.
# Examples: techpulse.example.com · localhost (local trial) · :80 (plain HTTP)
DOMAIN=localhost

# Only if the frontend is hosted on a DIFFERENT domain than the API (comma-separated).
CORS_ORIGINS=

# Legacy mock "research job" endpoints. Keep false on public deployments.
ENABLE_LEGACY_JOBS_API=false

# Worker tuning
WORKER_CONCURRENCY=4
LEASE_SECONDS=30
HEARTBEAT_SECONDS=10
POLL_INTERVAL_SECONDS=1.0
RECOVERY_INTERVAL_SECONDS=5.0
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
DEFAULT_MAX_ATTEMPTS=3
MOCK_STAGE_DELAY_SECONDS=0.5

# TechPulse ingestion
SCHEDULER_POLL_SECONDS=30
INGEST_MAX_ATTEMPTS=3
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5000000
FETCH_PER_HOST_CONCURRENCY=2
HTTP_USER_AGENT=TechPulse/0.2 (feed aggregator)

LOG_LEVEL=INFO
