# Leave empty to call the API on the same origin (/api, proxied by Vite in development).
# For a separately hosted API, set its origin and add this frontend's origin to the
# backend's CORS_ORIGINS.
VITE_API_BASE_URL=
# Where the Vite dev server forwards /api and /health.
VITE_API_PROXY_TARGET=http://localhost:8000
